<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.curso</groupId>
        <artifactId>diccionarios</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>aplicacion-completa</artifactId>
    <version>1.0.0</version>

    <name>Aplicación de diccionarios completa con interfaz de usuario de consola y con diccionarios en ficheros</name>

    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>com.curso</groupId>
            <!--artifactId>diccionarios-en-ficheros</artifactId>-->
            <artifactId>diccionarios-en-servicio-web</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso</groupId>
            <artifactId>ui-consola</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--
        La interfaz de usuario de escritorio (JavaFX).
        Fijaos en que ui-consola SIGUE AQUÍ: las dos implementaciones conviven
        sin estorbarse, y quien elige cuál se usa es la factoría.
        -->
        <dependency>
            <groupId>com.curso</groupId>
            <artifactId>ui-escritorio</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso</groupId>
            <artifactId>diccionario-en</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso</groupId>
            <artifactId>diccionario-es</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso</groupId>
            <artifactId>diccionarios-api</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso</groupId>
            <artifactId>ui-api</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- La clase Aplicacion vive en un paquete; sobreescribimos el mainClass
                 heredado del pom padre (que apuntaba al paquete por defecto). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.curso.diccionarios.app.cliente.Aplicacion</mainClass>
                </configuration>
                <!--
                Dos atajos para arrancar los dos actos de la sesión:

                    mvn -pl aplicacion-completa exec:exec@acto1
                    mvn -pl aplicacion-completa exec:exec@acto2

                ¿Por qué exec:exec y no el exec:java de siempre?
                Porque exec:java ejecuta nuestro código DENTRO del proceso de
                Maven y en un hilo secundario, y las ventanas gráficas en macOS
                exigen el hilo principal del proceso. exec:exec lanza una JVM
                nueva y limpia, como haría un doble clic sobre el programa.
                Es un detalle muy de escritorio y muy fácil de sufrir.
                -->
                <executions>
                    <execution>
                        <id>acto1</id>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.curso.diccionarios.app.cliente.Aplicacion</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>acto2</id>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.curso.diccionarios.app.cliente.LanzadorDeEscritorio</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.curso.diccionarios.app.cliente.Aplicacion</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>